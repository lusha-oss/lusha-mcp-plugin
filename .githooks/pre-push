#!/bin/sh
# Block pushes when the Codex skills copy has drifted from root skills/.
set -eu

repo_root="$(git rev-parse --show-toplevel)"
"$repo_root/scripts/sync-codex-skills.sh"

if [ -n "$(git status --porcelain codex-plugin/skills)" ]; then
  echo "error: codex-plugin/skills/ is out of sync with skills/." >&2
  echo "Synced it for you — commit the result before pushing:" >&2
  echo "  git add codex-plugin/skills && git commit -m 'chore: sync codex skills'" >&2
  exit 1
fi
